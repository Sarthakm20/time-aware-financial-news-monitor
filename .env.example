# Copy this file to .env (same folder) and fill in what you have. .env is git-ignored: never commit it.

# Google Gemini (free key: https://aistudio.google.com/apikey). Used by:
#   live-annotate          : an independent LLM labels a daily sample of live headlines (live accuracy check)
#   live-update --live-sources google yahoo gemini : extra headlines found through Google Search grounding
#   The model is fixed in code to gemini-3.1-flash-lite (src/gemini.py, MODEL); it cannot be changed here.
GEMINI_API_KEY=

# Optional extra headline source (free key: https://finnhub.io/register)
FINNHUB_API_KEY=

# Optional: Slack or Discord incoming-webhook URL for the 'alerts' stage
ALERT_WEBHOOK_URL=

# Optional: torch | onnx | auto. 'onnx' runs the int8 model without PyTorch (~300 MB less RAM).
SENTIMENT_BACKEND=onnx
